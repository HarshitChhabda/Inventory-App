    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^6.20.2",
    "@prisma/client": "^5.10.0",
    "@react-pdf/renderer": "^3.4.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-table": "^8.11.0",
    "@tanstack/react-virtual": "^3.10.0",
    "dayjs": "^1.11.21",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
