{
  "name": "mahaveerji-inventory",
  "version": "1.6.0",
  "description": "Store & Material Movement Management System for Digamber Jain Atishay Kshetra, Shri Mahaveerji",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist-electron.js && node scripts/patch-entry.js",
    "build": "tsc && vite build && node scripts/patch-entry.js && electron-builder",
    "build:win": "tsc && vite build && node scripts/patch-entry.js && electron-builder --win",
    "build:prod": "node scripts/build-production.js",
    "build:prod:win": "node scripts/build-production.js --win",
    "build:prod:mac": "node scripts/build-production.js --mac",
    "build:prod:linux": "node scripts/build-production.js --linux",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^5.7.1",
    "@mui/icons-material": "^5.15.0",
    "@mui/lab": "^5.0.0-alpha.177",
    "@mui/material": "^5.15.0",
    "@mui/x-date-pickers": "^6.20.2",
    "@prisma/client": "^5.10.0",
    "@react-pdf/renderer": "^3.4.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@types/file-saver": "^2.0.7",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.21",
    "electron-updater": "^6.1.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.84.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.0",
    "xml2js": "^0.6.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^5.10.0",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  }
}
