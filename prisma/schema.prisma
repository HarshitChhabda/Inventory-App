generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                 Int                          @id @default(autoincrement())
  uuid               String                       @unique @default(uuid())
  name               String                       @unique
  address            String?
  phone              String?
  email              String?
  gstNumber          String?
  logoPath           String?
  isActive           Boolean                      @default(true)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  amcAgreements      AMCAgreement[]
  approvalWorkflows  ApprovalWorkflow[]
  assets             AssetProfile[]
  auditLogs          AuditLog[]
  breakdownHistory   BreakdownHistory[]
  departments        Department[]
  dharmshalas        Dharmshala[]
  employees          Employee[]
  financialYears     FinancialYear[]
  goodsReceipts      GoodsReceipt[]
  importHistories    ImportHistory[]
  ledgers            LedgerEntry[]
  maintenanceHistory MaintenanceHistory[]
  notifications      Notification[]
  passwordPolicy     PasswordPolicy?
  priceHistory       PriceHistory[]
  purchaseHistory    PurchaseHistory[]
  purchaseOrders     PurchaseOrder[]
  quotations         Quotation[]
  requisitions       RequisitionHeader[]
  roles              Role[]
  serviceRequests    ServiceRequest[]
  serviceSchedules   ServiceSchedule[]
  stores             Store[]
  configurations     SystemConfiguration[]
  transactions       TransactionHeader[]
  vendors            Vendor[]
  voucherSequences   VoucherSequence[]
  warrantyClaims     WarrantyClaim[]
  consumptions       MaterialConsumption[]
  installations      MaterialInstallation[]
  completions        WorkCompletionVerification[]
  workOrders         WorkOrder[]
}

model FinancialYear {
  id                Int                          @id @default(autoincrement())
  uuid              String                       @unique @default(uuid())
  companyId         Int
  label             String
  startDate         DateTime
  endDate           DateTime
  isClosed          Boolean                      @default(false)
  closedAt          DateTime?
  closedBy          Int?
  openingStockJson  String?
  closingStockJson  String?
  openingLedgerJson String?
  closingLedgerJson String?
  totalReceipts     Float                        @default(0)
  totalIssues       Float                        @default(0)
  totalTransfers    Float                        @default(0)
  totalAdjustments  Float                        @default(0)
  totalDamage       Float                        @default(0)
  totalConsumption  Float                        @default(0)
  closingReportJson String?
  createdAt         DateTime                     @default(now())
  company           Company                      @relation(fields: [companyId], references: [id])
  goodsReceipts     GoodsReceipt[]
  importHistories   ImportHistory[]
  ledgers           LedgerEntry[]
  purchaseOrders    PurchaseOrder[]
  requisitions      RequisitionHeader[]
  serviceRequests   ServiceRequest[]
  transactions      TransactionHeader[]
  consumptions      MaterialConsumption[]
  installations     MaterialInstallation[]
  voucherSequences  VoucherSequence[]
  completions       WorkCompletionVerification[]
  workOrders        WorkOrder[]

  @@unique([companyId, label])
  @@index([companyId])
}

model Department {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  companyId        Int
  name             String
  code             String?
  departmentType   String              @default("Department")
  isActive         Boolean             @default(true)
  assets           AssetProfile[]      @relation("AssetCurrentDept")
  company          Company             @relation(fields: [companyId], references: [id])
  employees        Employee[]
  requisitions     RequisitionHeader[]
  destRequisitions RequisitionHeader[] @relation("DestDepartment")
  stores           Store[]
  transactions     TransactionHeader[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Store {
  id                 Int                 @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  companyId          Int
  departmentId       Int?
  name               String
  code               String?
  storeType          String              @default("MAIN_STORE")
  parentStoreId      Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assetInstallations AssetInstallation[]
  assets             AssetProfile[]      @relation("AssetCurrentStore")
  goodsReceipts      GoodsReceipt[]
  categories         ItemCategory[]
  ledgers            LedgerEntry[]
  locations          Location[]
  sourceRequisitions RequisitionHeader[] @relation("SourceStore")
  destRequisitions   RequisitionHeader[] @relation("DestStore")
  serializedItems    SerializedItem[]
  company            Company             @relation(fields: [companyId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  parentStore        Store?              @relation("StoreHierarchy", fields: [parentStoreId], references: [id])
  childStores        Store[]             @relation("StoreHierarchy")
  transactionsFrom   TransactionHeader[] @relation("TxFromStore")
  transactionsTo     TransactionHeader[] @relation("TxToStore")
   consumptions       MaterialConsumption[]
   installations      MaterialInstallation[]

   @@unique([companyId, name])
  @@index([companyId])
  @@index([storeType])
  @@index([parentStoreId])
  @@index([departmentId])
}

model Dharmshala {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  companyId        Int
  name             String
  code             String?
  address          String?
  contactPerson    String?
  contactPhone     String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  company          Company             @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
}

model Location {
  id               Int                 @id @default(autoincrement())
  uuid             String              @unique @default(uuid())
  storeId          Int
  name             String
  code             String?
  locationType     String
  parentId         Int?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  assets           AssetProfile[]      @relation("AssetCurrentLocation")
  ledgers          LedgerEntry[]
  store            Store               @relation(fields: [storeId], references: [id])
  parent           Location?           @relation("LocationHierarchy", fields: [parentId], references: [id])
  children         Location[]          @relation("LocationHierarchy")
  rooms                    Room[]
  transactionsFrom         TransactionHeader[] @relation("TxFromLocation")
  transactionsTo           TransactionHeader[] @relation("TxToLocation")
  transactionDetailsFrom   TransactionDetail[] @relation("TxDetailFromLocation")
  transactionDetailsTo     TransactionDetail[] @relation("TxDetailToLocation")
  demandItems              MaterialDemandItem[]
   consumptions       MaterialConsumption[]
   installations      MaterialInstallation[]

  @@index([storeId])
  @@index([locationType])
  @@index([parentId])
}

model Room {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(uuid())
  locationId    Int
  name          String
  code          String?
  floor         String?
  capacity      Int?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  installations AssetInstallation[]
  assets        AssetProfile[]      @relation("AssetCurrentRoom")
  location      Location            @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

model ItemCategory {
  id            Int               @id @default(autoincrement())
  uuid          String            @unique @default(uuid())
  storeId       Int?
  name          String
  prefix        String            @default("GEN")
  isActive      Boolean           @default(true)
  items         Item[]
  store         Store?            @relation(fields: [storeId], references: [id])
  subCategories ItemSubCategory[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([name])
}

model ItemSubCategory {
  id         Int          @id @default(autoincrement())
  uuid       String       @unique @default(uuid())
  categoryId Int
  name       String
  isActive   Boolean      @default(true)
  items      Item[]
  category   ItemCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Unit {
  id       Int     @id @default(autoincrement())
  uuid     String  @unique @default(uuid())
  name     String  @unique
  symbol   String?
  isActive Boolean @default(true)
  items    Item[]

  @@index([name])
}

model Brand {
  id       Int            @id @default(autoincrement())
  uuid     String         @unique @default(uuid())
  name     String         @unique
  isActive Boolean        @default(true)
  assets   AssetProfile[]
  items    Item[]

  @@index([name])
}

model Item {
  id                    Int                    @id @default(autoincrement())
  uuid                  String                 @unique @default(uuid())
  itemCode              String                 @unique
  itemName              String
  categoryId            Int
  subCategoryId         Int?
  unitId                Int
  brandId               Int?
  defaultVendorId       Int?
  itemType              String                 @default("NON_SERIALIZED")
  isSerialized          Boolean                @default(false)
  hasWarranty           Boolean                @default(false)
  warrantyMonths        Int?
  hasAMC                Boolean                @default(false)
  amcMonths             Int?
  hsnCode               String?
  barcode               String?
  qrCode                String?
  minimumStockLevel     Decimal                @default(0)
  maximumStockLevel     Decimal?
  reorderLevel          Decimal?
  description           String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  amcRecords            AMCRecord[]
  assetInstallations    AssetInstallation[]
  assets                AssetProfile[]
  grnDetails            GoodsReceiptDetail[]
  category              ItemCategory           @relation(fields: [categoryId], references: [id])
  subCategory           ItemSubCategory?       @relation(fields: [subCategoryId], references: [id])
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  itemVendorMappings    ItemVendorMapping[]
  ledgers               LedgerEntry[]
  demandItems           MaterialDemandItem[]
  consumptionItems      MaterialConsumptionItem[]
  priceHistory          PriceHistory[]
  purchaseHistory       PurchaseHistory[]
  poDetails             PurchaseOrderDetail[]
  qualityChecks         QualityCheck[]
  requisitionDetails    RequisitionDetail[]
  serializedItems       SerializedItem[]
  transactionDetails    TransactionDetail[]
  warrantyRecords       WarrantyRecord[]
   completionItems       WorkCompletionItem[]
   workOrderSpareParts   WorkOrderSparePart[]
   installationItems     MaterialInstallationItem[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([unitId])
  @@index([brandId])
  @@index([itemType])
  @@index([isSerialized])
  @@index([isActive])
  @@index([barcode])
  @@index([qrCode])
}

model Employee {
  id           Int         @id @default(autoincrement())
  uuid         String      @unique @default(uuid())
  companyId    Int
  departmentId Int?
  employeeCode String      @unique
  firstName    String
  lastName     String?
  phone        String?
  email        String?
  designation  String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  company      Company     @relation(fields: [companyId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([companyId])
  @@index([departmentId])
  @@index([employeeCode])
}

model ReasonMaster {
  id           Int                 @id @default(autoincrement())
  uuid         String              @unique @default(uuid())
  reasonType   String
  name         String
  description  String?
  isActive     Boolean             @default(true)
  transactions TransactionHeader[]

  @@unique([reasonType, name])
  @@index([reasonType])
}

model WarrantyRecord {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  itemId        Int
  serialNumber  String?
  vendorName    String?
  purchaseDate  DateTime
  warrantyStart DateTime
  warrantyEnd   DateTime
  status        String   @default("ACTIVE")
  remarks       String?
  createdAt     DateTime @default(now())
  item          Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([serialNumber])
  @@index([status])
  @@index([warrantyEnd])
}

model AMCRecord {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  itemId       Int
  serialNumber String?
  vendorName   String?
  amcStart     DateTime
  amcEnd       DateTime
  amount       Decimal  @default(0)
  status       String   @default("ACTIVE")
  remarks      String?
  createdAt    DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([serialNumber])
  @@index([status])
  @@index([amcEnd])
}

model AssetInstallation {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  itemId          Int
  roomId          Int
  storeId         Int
  quantity        Decimal   @default(1)
  installedDate   DateTime
  installedBy     String?
  uninstalledDate DateTime?
  uninstalledBy   String?
  status          String    @default("ACTIVE")
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  item            Item      @relation(fields: [itemId], references: [id])
  room            Room      @relation(fields: [roomId], references: [id])
  store           Store     @relation(fields: [storeId], references: [id])

  @@index([itemId])
  @@index([roomId])
  @@index([storeId])
  @@index([status])
}

model AssetProfile {
  id                  Int                   @id @default(autoincrement())
  uuid                String                @unique @default(uuid())
  assetCode           String                @unique
  qrCode              String?               @unique
  barcode             String?               @unique
  serialNumber        String?
  companyId           Int
  assetName           String
  itemId              Int
  brandId             Int?
  modelNumber         String?
  description         String?
  purchaseDate        DateTime?
  purchaseCost        Decimal?              @default(0)
  vendorId            Int?
  invoiceNumber       String?
  purchaseOrderId     String?
  grnNumber           String?
  currentStoreId      Int?
  currentLocationId   Int?
  currentRoomId       Int?
  currentDepartmentId Int?
  status              String                @default("PURCHASED")
  condition           String                @default("EXCELLENT")
  installationDate    DateTime?
  expectedLifeYears   Int?                  @default(5)
  expectedLifeMonths  Int?                  @default(0)
  disposalDate        DateTime?
  disposalReason      String?
  healthScore         Int                   @default(100)
  repairCount         Int                   @default(0)
  totalRepairCost     Decimal               @default(0)
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  warrantyVendor      String?
  warrantyTerms       String?
  amcStart            DateTime?
  amcEnd              DateTime?
  amcVendor           String?
  amcAmount           Decimal?              @default(0)
  amcTerms            String?
  photoUrl            String?
  remarks             String?
  createdBy           String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  amcAgreements       AMCAgreement[]
  documents           AssetDocument[]
  movements           AssetMovement[]
  photos              AssetPhoto[]
  company             Company               @relation(fields: [companyId], references: [id])
  item                Item                  @relation(fields: [itemId], references: [id])
  brand               Brand?                @relation(fields: [brandId], references: [id])
  vendor              Vendor?               @relation(fields: [vendorId], references: [id])
  currentStore        Store?                @relation("AssetCurrentStore", fields: [currentStoreId], references: [id])
  currentLocation     Location?             @relation("AssetCurrentLocation", fields: [currentLocationId], references: [id])
  currentRoom         Room?                 @relation("AssetCurrentRoom", fields: [currentRoomId], references: [id])
  currentDepartment   Department?           @relation("AssetCurrentDept", fields: [currentDepartmentId], references: [id])
  services            AssetServiceHistory[]
  timeline            AssetTimeline[]
  breakdownHistory    BreakdownHistory[]
  maintenanceHistory  MaintenanceHistory[]
  serviceRequests     ServiceRequest[]
  serviceSchedules    ServiceSchedule[]
  warrantyClaims      WarrantyClaim[]
  workOrders          WorkOrder[]

  @@index([companyId])
  @@index([assetCode])
  @@index([serialNumber])
  @@index([itemId])
  @@index([status])
  @@index([condition])
  @@index([currentStoreId])
  @@index([currentRoomId])
  @@index([currentDepartmentId])
  @@index([healthScore])
  @@index([warrantyEnd])
  @@index([amcEnd])
  @@index([companyId, status])
  @@index([companyId, currentStoreId])
  @@index([companyId, status, currentStoreId])
  @@index([status, currentStoreId, currentDepartmentId])
}

model AssetTimeline {
  id               Int          @id @default(autoincrement())
  uuid             String       @unique @default(uuid())
  assetId          Int
  eventType        String
  eventDate        DateTime
  voucherNo        String?
  transactionId    Int?
  fromStoreId      Int?
  fromLocationId   Int?
  fromRoomId       Int?
  fromDepartmentId Int?
  toStoreId        Int?
  toLocationId     Int?
  toRoomId         Int?
  toDepartmentId   Int?
  performedBy      String?
  reason           String?
  remarks          String?
  metadata         String?
  createdAt        DateTime     @default(now())
  asset            AssetProfile @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([eventType])
  @@index([eventDate])
  @@index([voucherNo])
}

model AssetPhoto {
  id        Int          @id @default(autoincrement())
  uuid      String       @unique @default(uuid())
  assetId   Int
  photoType String
  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?
  caption   String?
  takenAt   DateTime?
  takenBy   String?
  createdAt DateTime     @default(now())
  asset     AssetProfile @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([photoType])
}

model AssetDocument {
  id           Int          @id @default(autoincrement())
  uuid         String       @unique @default(uuid())
  assetId      Int
  documentType String
  fileName     String
  filePath     String
  fileSize     Int?
  mimeType     String?
  description  String?
  uploadedBy   String?
  createdAt    DateTime     @default(now())
  asset        AssetProfile @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([documentType])
}

model AssetServiceHistory {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(uuid())
  assetId         Int
  serviceDate     DateTime
  serviceType     String
  description     String?
  engineerName    String?
  engineerContact String?
  vendorId        Int?
  vendorName      String?
  cost            Decimal      @default(0)
  conditionBefore String?
  conditionAfter  String?
  warrantyClaim   Boolean      @default(false)
  nextServiceDate DateTime?
  remarks         String?
  photoBeforePath String?
  photoAfterPath  String?
  createdAt       DateTime     @default(now())
  asset           AssetProfile @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([serviceDate])
  @@index([serviceType])
  @@index([vendorId])
}

model AssetMovement {
  id               Int                @id @default(autoincrement())
  uuid             String             @unique @default(uuid())
  assetId          Int
  transactionId    Int?
  voucherNo        String?
  movementType     String
  movementDate     DateTime
  fromStoreId      Int?
  fromLocationId   Int?
  fromRoomId       Int?
  fromDepartmentId Int?
  toStoreId        Int?
  toLocationId     Int?
  toRoomId         Int?
  toDepartmentId   Int?
  performedBy      String?
  reason           String?
  remarks          String?
  createdAt        DateTime           @default(now())
  asset            AssetProfile       @relation(fields: [assetId], references: [id])
  transaction      TransactionHeader? @relation(fields: [transactionId], references: [id])

  @@index([assetId])
  @@index([transactionId])
  @@index([movementType])
  @@index([movementDate])
}

model TransactionHeader {
  id              Int                 @id @default(autoincrement())
  uuid            String              @unique @default(uuid())
  companyId       Int
  financialYearId Int
  voucherNo       String
  voucherType     String
  transactionDate DateTime
  invoiceDate     DateTime?
  fromStoreId     Int?
  toStoreId       Int?
  fromLocationId  Int?
  toLocationId    Int?
  vendorId        Int?
  reasonId        Int?
  departmentId    Int?
  approvalStatus  String              @default("DRAFT")
  approvedBy      String?
  approvedAt      DateTime?
  postedBy        String?
  postedAt        DateTime?
  cancelledBy     String?
  cancelledAt     DateTime?
  cancelReason    String?
  referenceNo     String?
  vehicleNumber   String?
  receivedBy      String?
  issuedBy        String?
  purpose         String?
  remarks         String?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assetMovements  AssetMovement[]
  ledgers         LedgerEntry[]
  requisitions    RequisitionHeader[]
  serialMovements SerialMovement[]
  details         TransactionDetail[]
  demandAllocations DemandAllocation[]
  consumptions      MaterialConsumption[]
   consumptionItems  MaterialConsumptionItem[]
   installationItems  MaterialInstallationItem[]
   company         Company             @relation(fields: [companyId], references: [id])
  financialYear   FinancialYear       @relation(fields: [financialYearId], references: [id])
  fromStore       Store?              @relation("TxFromStore", fields: [fromStoreId], references: [id])
  toStore         Store?              @relation("TxToStore", fields: [toStoreId], references: [id])
  fromLocation    Location?           @relation("TxFromLocation", fields: [fromLocationId], references: [id])
  toLocation      Location?           @relation("TxToLocation", fields: [toLocationId], references: [id])
  department      Department?         @relation(fields: [departmentId], references: [id])
  vendor          Vendor?             @relation(fields: [vendorId], references: [id])
  reason          ReasonMaster?       @relation(fields: [reasonId], references: [id])

  @@unique([companyId, financialYearId, voucherNo])
  @@index([companyId])
  @@index([financialYearId])
  @@index([voucherType])
  @@index([transactionDate])
  @@index([approvalStatus])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@index([vendorId])
  @@index([companyId, financialYearId])
  @@index([companyId, financialYearId, voucherType])
  @@index([companyId, financialYearId, approvalStatus])
  @@index([companyId, financialYearId, voucherType, approvalStatus])
  @@index([companyId, transactionDate])
  @@index([fromStoreId, transactionDate])
  @@index([toStoreId, transactionDate])
  @@index([companyId, financialYearId, transactionDate])
}

model TransactionDetail {
  id             Int               @id @default(autoincrement())
  uuid           String            @unique @default(uuid())
  transactionId  Int
  itemId         Int
  unitId         Int?
  quantity       Decimal
  rate           Decimal           @default(0)
  amount         Decimal           @default(0)
  serialNumber   String?
  batchNumber    String?
  condition      String            @default("GOOD")
  warrantyExpiry DateTime?
  fromLocationId Int?
  toLocationId   Int?
  remarks        String?
  createdAt      DateTime          @default(now())
  transaction    TransactionHeader @relation(fields: [transactionId], references: [id])
  item           Item              @relation(fields: [itemId], references: [id])
  fromLocation   Location?         @relation("TxDetailFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location?         @relation("TxDetailToLocation", fields: [toLocationId], references: [id])

  @@index([transactionId])
  @@index([itemId])
  @@index([serialNumber])
  @@index([batchNumber])
  @@index([condition])
}

model LedgerEntry {
  id              Int                @id @default(autoincrement())
  uuid            String             @unique @default(uuid())
  companyId       Int
  financialYearId Int
  transactionId   Int?
  itemId          Int
  storeId         Int
  locationId      Int?
  voucherNo       String
  voucherType     String
  movementType    String
  quantityIn      Decimal            @default(0)
  quantityOut     Decimal            @default(0)
  balanceQty      Decimal            @default(0)
  rate            Decimal            @default(0)
  condition       String             @default("GOOD")
  serialNumber    String?
  batchNumber     String?
  transactionDate DateTime
  createdBy       String
  createdAt       DateTime           @default(now())
  company         Company            @relation(fields: [companyId], references: [id])
  financialYear   FinancialYear      @relation(fields: [financialYearId], references: [id])
  transaction     TransactionHeader? @relation(fields: [transactionId], references: [id])
  item            Item               @relation(fields: [itemId], references: [id])
  store           Store              @relation(fields: [storeId], references: [id])
  location        Location?          @relation(fields: [locationId], references: [id])

  @@index([companyId, financialYearId, itemId])
  @@index([companyId, financialYearId, storeId])
  @@index([companyId, financialYearId, itemId, storeId])
  @@index([companyId, financialYearId, movementType])
  @@index([companyId, financialYearId, transactionDate])
  @@index([itemId, storeId])
  @@index([itemId, transactionDate])
  @@index([transactionId])
  @@index([voucherNo])
  @@index([storeId, itemId, financialYearId])
  @@index([serialNumber])
  @@index([batchNumber])
  @@index([createdAt])
  @@index([companyId, financialYearId, storeId, itemId])
  @@index([companyId, financialYearId, movementType, transactionDate])
  @@index([itemId, storeId, financialYearId, transactionDate])
}

model SerializedItem {
  id                Int              @id @default(autoincrement())
  uuid              String           @unique @default(uuid())
  itemId            Int
  serialNumber      String
  batchNumber       String?
  assetTag          String?
  manufactureDate   DateTime?
  purchaseDate      DateTime?
  warrantyExpiry    DateTime?
  currentStoreId    Int?
  currentLocationId Int?
  currentRoomId     Int?
  status            String           @default("AVAILABLE")
  condition         String           @default("GOOD")
  purchasePrice     Decimal?
